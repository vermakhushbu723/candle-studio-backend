NODE_ENV=development
PORT=5050
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/candlestudio?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173,http://localhost:5180
ADMIN_EMAIL=admin@candledust.in
ADMIN_PASSWORD=Candle@2026

# Razorpay (Dashboard → Account & Settings → API Keys). Use rzp_test_… keys for testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhooks (Dashboard → Webhooks → secret). Point the webhook at https://<your-api>/api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# Phone OTP login: true = OTP shown in server log + API response (testing). Set false once an SMS provider is wired.
OTP_DEV_MODE=true

# Google sign-in: OAuth 2.0 Web client ID (Google Cloud Console → Credentials)
GOOGLE_CLIENT_ID=
